{
  "name": "@nexcall/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import ./dist/test/setup-env.js --test --experimental-test-isolation=none --test-concurrency=1 dist/app.test.js dist/middleware/authorize.test.js dist/models/User.test.js dist/services/analytics.service.test.js dist/services/call.service.test.js dist/services/lead.service.test.js dist/services/telecaller.service.test.js dist/services/token.service.test.js",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:demo": "tsx src/scripts/seedDemo.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.30",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
